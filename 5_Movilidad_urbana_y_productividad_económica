    "# Limpia separadores y convierte columnas numéricas en eco\n",
    "# Calcula la población total en unidades absolutas (Multiplica * 1000000)\n",
    "# eco['population'] = ...\n",
    "\n",
    "# verificar el cambio\n",
    "eco.info()\n",
    "eco.head(3)\n",
    "# city_gdp_capita: eliminar puntos (miles) y reemplazar comas por puntos (decimales)\n",
    "eco['city_gdp_capita'] = (\n",
    "    eco['city_gdp_capita']\n",
    "    .astype(str)\n",
    "    .str.replace('.', '', regex=False)\n",
    "    .str.replace(',', '.', regex=False)\n",
    "    .astype(float)\n",
    ")\n",
    "\n",
    "# unemployment_pct: eliminar el símbolo % y reemplazar comas por puntos\n",
    "eco['unemployment_pct'] = (\n",
    "    eco['unemployment_pct']\n",
    "    .astype(str)\n",
    "    .str.replace('%', '', regex=False)\n",
    "    .str.replace(',', '.', regex=False)\n",
    "    .astype(float)\n",
    ")\n",
    "\n",
    "# population_m: reemplazar comas por puntos\n",
    "eco['population_m'] = (\n",
    "    eco['population_m']\n",
    "    .astype(str)\n",
    "    .str.replace(',', '.', regex=False)\n",
    "    .astype(float)\n",
    ")\n",
    "\n",
    "# 3. Crear columna population (población total)\n",
    "eco['population'] = eco['population_m'] * 1_000_000\n",
    "\n",
    "# Verificar resultados\n",
    "print(traffic['update_time_utc'].dtype)\n",
    "eco[['city_gdp_capita', 'unemployment_pct', 'population_m', 'population']].head()"
   ]
